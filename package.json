{
  "name": "tauri-nuxt-dev",
  "description": "A development runner for Tauri and Nuxt with automatic port resolution.",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "oxfmt --check && oxlint"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.82.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1"
}
