{
  "name": "tauri-nuxt-dev",
  "description": "A development runner for Tauri and Nuxt with automatic port resolution.",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcvzmoon/tauri-nuxt-dev.git"
  },
  "bugs": {
    "url": "https://github.com/xcvzmoon/tauri-nuxt-dev/issues"
  },
  "homepage": "https://github.com/xcvzmoon/tauri-nuxt-dev#readme",
  "keywords": [
    "tauri",
    "nuxt",
    "dev",
    "port",
    "get-port-please",
    "desktop"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "tauri-nuxt-dev": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "oxfmt --check && oxlint",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:verbose": "vitest run --reporter=verbose",
    "prepare": "simple-git-hooks",
    "release": "genbumppush"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm fmt && pnpm lint",
    "pre-push": "pnpm check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "c12": "4.0.0-rc.1",
    "consola": "^3.4.2",
    "get-port-please": "^3.2.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.82.0",
    "@types/node": "^26.5.1",
    "genbumppush": "^0.0.6",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "tsdown-stale-guard": "^0.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1"
}
