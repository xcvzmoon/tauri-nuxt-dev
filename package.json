{
  "name": "tauri-nuxt-dev",
  "description": "A development runner for Tauri and Nuxt with automatic port resolution.",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "oxfmt --check && oxlint",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:verbose": "vitest run --reporter=verbose"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.82.0",
    "@types/node": "^26.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1"
}
